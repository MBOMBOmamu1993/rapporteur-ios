<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
	<string>Rapporteur</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
	</array>
	<!-- Le retour de la connexion Google : rapporteur://connexion?billet=…
	     Le parcours se joue hors de l'application (ASWebAuthenticationSession),
	     et la session naît ici, contre billet ET défi. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lerapporteur.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rapporteur</string>
			</array>
		</dict>
	</array>
	<!-- Le micro, et rien d'autre : la seule chose que le téléphone apporte. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Rapporteur enregistre votre réunion par le microphone pour en rédiger le compte rendu. L'enregistrement continue écran éteint et part vers nos serveurs à la fin de la séance.</string>
	<!-- L'enregistrement continue écran éteint : c'est le mode « audio » qui
	     l'autorise — la même promesse que le service de premier plan Android. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Principale</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).DelegueScene</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Un écran de lancement vide, couleur du fond : sans lui, iOS affiche
	     l'application en mode compatibilité, avec des bandes noires. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Fond</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Seul HTTPS vers lerapporteur.com : aucune exception de transport. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- Le chiffrement n'est que le HTTPS standard : exempt de déclaration
	     d'exportation, et App Store Connect ne posera plus la question. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
</dict>
</plist>
